# Copy to .env; never commit the real key.
PORT=3000
OPENAI_API_KEY=
# Cloud settings may instead inject ATLAS_OPENAI_API_KEY. Never put either key in public/.
# This is the only model currently covered by the conservative reservation policy.
OPENAI_MODEL=gpt-4.1-mini
# Reservations are local authorization limits, not verified OpenAI invoice totals.
# Defaults: $1/day, at most 5 runs/day and 5 questions/run; 8–15 tracked questions.
ATLAS_DAILY_SPEND_CAP_USD=1
ATLAS_MAX_RUNS_PER_DAY=5
ATLAS_MAX_PROMPTS=15
ATLAS_MAX_PROMPTS_PER_RUN=5
# Minimum $0.05 reserved per attempted question; failures retain their reservation.
ATLAS_RESERVATION_PER_PROMPT_USD=0.05
ATLAS_MAX_OUTPUT_TOKENS=1200
# Hosted Supabase API (api/index.js); these do not turn the local server into a host.
SUPABASE_URL=https://pznsarkpjaykanxlmqix.supabase.co
# Modern key pair: publishable key goes in SUPABASE_ANON_KEY; server-only secret
# key goes in SUPABASE_SERVICE_ROLE_KEY. The variable names preserve compatibility.
SUPABASE_KEY_MODE=modern
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Canonical SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY names are also accepted.
# For legacy anon/service_role JWTs, explicitly set SUPABASE_KEY_MODE=legacy.
# Exact final HTTPS Vercel/custom-domain origin; never guess the assigned domain.
ATLAS_APP_URL=
# Local-only starter. Deploy only after authentication and security hardening.
