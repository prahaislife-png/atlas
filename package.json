{
  "name": "atlas-ai-visibility",
  "private": true,
  "version": "0.3.0",
  "description": "ATLAS evidence-first research with Supabase hosted foundations",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.js",
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "python tests/browser_smoke.py",
    "test:db": "node scripts/test-db.js",
    "test:hosted-browser": "python tests/hosted_browser.py",
    "verify:supabase": "node --env-file-if-exists=.env scripts/verify-supabase.js",
    "vercel-build": "node scripts/vercel-build.js",
    "check": "node --check server.js && node --check public/app.js && node --test tests/*.test.js"
  },
  "engines": { "node": ">=22" }
}
